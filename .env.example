# At least one chat provider key is required
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

XKIRO_API_KEY=sk-xt-your_api_key_here
XKIRO_MODEL=mistralai/ministral-14b

DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Auth.js / NextAuth (required for Gmail sign-in)
AUTH_SECRET=generate_with_openssl_rand_base64_32
AUTH_GOOGLE_ID=your_google_oauth_client_id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret
# Local only. On Vercel: DELETE this variable (or set to https://your-app.vercel.app).
# Leaving AUTH_URL=http://localhost:3000 on Vercel redirects Get Started → localhost.
AUTH_URL=http://localhost:3000

# Optional public app URL
# Local: http://localhost:3000 | Vercel: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
