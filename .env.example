# =============================================================================
# BarreAI — environment variables
# Copy to .env.local for local dev. On Vercel: Project → Settings → Environment
# Variables → add each key for Production, Preview, and Development.
# NEVER commit .env.local or real secrets to GitHub.
# =============================================================================

# OpenRouter (required for chat)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Neon Postgres (required for conversations / users)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Auth.js / NextAuth (required in production)
# Generate: openssl rand -base64 32
AUTH_SECRET=generate_with_openssl_rand_base64_32

# Google OAuth (Google Cloud Console → Credentials → OAuth 2.0 Client)
AUTH_GOOGLE_ID=your_google_oauth_client_id
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret

# App URL
# Local:  http://localhost:3000
# Vercel: https://YOUR_PROJECT.vercel.app  (or your custom domain)
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google Cloud Console (after Vercel deploy) ---
# Authorized JavaScript origins:  https://YOUR_PROJECT.vercel.app
# Authorized redirect URIs:       https://YOUR_PROJECT.vercel.app/api/auth/callback/google
